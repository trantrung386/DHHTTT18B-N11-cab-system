{
	"info": {
		"name": "Cab Booking - Booking Service API",
		"description": "Postman Collection for testing the Cab Booking System Booking Service",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health Check (Root)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						""
					]
				}
			},
			"response": []
		},
		{
			"name": "Health Check (Booking API)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/bookings/health",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"bookings",
						"health"
					]
				}
			},
			"response": []
		},
		{
			"name": "Create Booking",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"customerId\": \"{{user_id}}\",\n  \"pickup\": {\n    \"lat\": 10.76,\n    \"lng\": 106.66\n  },\n  \"drop\": {\n    \"lat\": 10.77,\n    \"lng\": 106.70\n  },\n  \"distance_km\": 5,\n  \"paymentMethod\": \"CASH\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/bookings/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"bookings",
						""
					]
				}
			},
			"response": []
		},
		{
			"name": "Get User Bookings",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/bookings/customer/{{user_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"bookings",
						"customer",
						"{{user_id}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Booking by ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/bookings/{{booking_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"bookings",
						"{{booking_id}}"
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:3003",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "user_id",
			"value": "123",
			"type": "string"
		},
		{
			"key": "booking_id",
			"value": "",
			"type": "string"
		}
	]
}
