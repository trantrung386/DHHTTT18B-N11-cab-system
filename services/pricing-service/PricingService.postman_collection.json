{
	"info": {
		"name": "Cab Booking - Pricing Service API",
		"description": "Postman Collection for testing the Cab Booking System Pricing Service",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Health & Metrics",
			"item": [
				{
					"name": "Health Check (Pricing API)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/pricing/health",
							"host": ["{{base_url}}"],
							"path": ["api", "pricing", "health"]
						}
					}
				},
				{
					"name": "Get Metrics (Prometheus)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/metrics",
							"host": ["{{base_url}}"],
							"path": ["metrics"]
						}
					}
				}
			]
		},
		{
			"name": "2. Calculate Price",
			"item": [
				{
					"name": "Estimate Price (Happy Path)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"distance_km\": 5,\n  \"duration_minutes\": 15,\n  \"vehicleType\": \"standard\",\n  \"demandLevel\": \"high\",\n  \"supplyLevel\": \"low\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/pricing/estimate",
							"host": ["{{base_url}}"],
							"path": ["api", "pricing", "estimate"]
						}
					}
				},
				{
					"name": "Estimate Price (Simulate AI Model Error / Fallback)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"distance_km\": 5,\n  \"simulate_model_error\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/pricing/estimate",
							"host": ["{{base_url}}"],
							"path": ["api", "pricing", "estimate"]
						}
					}
				}
			]
		},
		{
			"name": "3. AI Forecast & Recommendation",
			"item": [
				{
					"name": "Price Forecast (Timeseries)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": {
							"raw": "{{base_url}}/api/pricing/forecast",
							"host": ["{{base_url}}"],
							"path": ["api", "pricing", "forecast"]
						}
					}
				},
				{
					"name": "Recommend Drivers",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/pricing/recommend-drivers?lat=10.76&lng=106.66&radius=5&top=3",
							"host": ["{{base_url}}"],
							"path": ["api", "pricing", "recommend-drivers"],
							"query": [
								{
									"key": "lat",
									"value": "10.76"
								},
								{
									"key": "lng",
									"value": "106.66"
								},
								{
									"key": "radius",
									"value": "5"
								},
								{
									"key": "top",
									"value": "3"
								}
							]
						}
					}
				},
				{
					"name": "Check Model Drift",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"baseline_mean\": 50000,\n  \"current_mean\": 65000,\n  \"threshold\": 0.2\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/pricing/drift-check",
							"host": ["{{base_url}}"],
							"path": ["api", "pricing", "drift-check"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:3001",
			"type": "string"
		}
	]
}
